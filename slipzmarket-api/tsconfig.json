{
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "generated/client/*": ["generated/client/*"]
    },
    "moduleResolution": "node",

    "target": "ESNext",
    "module": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "skipLibCheck": true,

    /* CRITICAL FIXES FOR YOUR LOGS */
    "noImplicitAny": false,         
         
    "strict": false,

    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}