{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",

    "baseUrl": "./src",
    "paths": {
      "generated/client/*": ["generated/client/*"]
    },

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* Strict Mode Overrides */
    "noImplicitAny": false,
    "strict": false,

    /* Silence Deprecation Warnings */
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*"]
}