<div class="header">
  <h1>Industry Penetration Analysis</h1>
</div>

<div class="summary">
  <h3>Top Sectors in {{workspaceName}}</h3>
  <ul>
    {{#each industries}}
      <li>{{this.name}}: {{this.count}} companies ({{this.percentage}}%)</li>
    {{/each}}
  </ul>
</div>

<table>
  <thead>
    <tr>
      <th>Industry Segment</th>
      <th>Company Count</th>
      <th>Avg. Company Size</th>
    </tr>
  </thead>
  <tbody>
    {{#each industries}}
    <tr>
      <td>{{this.name}}</td>
      <td>{{this.count}}</td>
      <td>{{this.avgSize}} employees</td>
    </tr>
    {{/each}}
  </tbody>
</table>