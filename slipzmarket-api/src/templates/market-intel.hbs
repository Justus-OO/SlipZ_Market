<div class="report-container">
  <h1>Industry Penetration Analysis</h1>
  
  <div class="section-title">Market Distribution</div>
  <table class="data-table">
    <thead>
      <tr>
        <th>Sector</th>
        <th>Growth</th>
        <th>Volume</th>
      </tr>
    </thead>
    <tbody>
      {{#each sectors}}
      <tr>
        <td>{{this.name}}</td>
        <td>
          <div class="progress-bar"><div class="fill" style="width: {{this.percentage}}%"></div></div>
        </td>
        <td>{{this.count}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>