<div class="audit-container">
  <div class="seal">
    <h1 style="color: #059669;">Verified Data Report</h1>
    <p>Reference: {{invoiceId}}</p>
  </div>

  <div class="audit-summary">
    <div class="score-box">{{qualityScore}}%</div>
    <p>Data Health Index</p>
  </div>

  <table class="data-table striped">
    <thead>
      <tr>
        <th>Contact</th>
        <th>Verification Status</th>
      </tr>
    </thead>
    <tbody>
      {{#each leads}}
      <tr>
        <td>{{this.firstName}} {{this.lastName}}</td>
        <td>
          {{#if this.emailValid}}<span class="status-success">● Valid</span>
          {{else}}<span class="status-warning">● Risky</span>{{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>